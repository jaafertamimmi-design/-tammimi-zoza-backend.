# ==============================================
# انسخ هذا الملف باسم .env واملأ القيم الحقيقية
# لا ترفع ملف .env نفسه على GitHub أو أي مكان عام أبداً
# ==============================================

# مفتاح توقيع الجلسات (JWT) - ولّده بهذا الأمر ولا تشاركه مع أحد:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ضع_هنا_مفتاح_عشوائي_طويل_32_بايت

# إيميلك أنت (المطور) - أول تسجيل بهذا الإيميل يصير أدمن تلقائياً، وبس هو
ADMIN_EMAIL=jaafertamimmi@gmail.com

# مفتاح Finnhub الحقيقي مالك (سجل حساب مجاني على finnhub.io وحط مفتاحك هنا)
FINNHUB_API_KEY=ضع_مفتاح_Finnhub_الحقيقي_مالك_هنا

# مفتاح goldprice.dev - اختياري تماماً، المصدر يشتغل مجاناً بدونه (خطة Free
# عبر رمز الأصل بس). لو رقّيت لخطة مدفوعة عندهم مستقبلاً، حط المفتاح هنا.
GOLDPRICE_API_KEY=

# رابط قاعدة البيانات - SQLite افتراضياً (كافي للبداية)
DATABASE_URL=sqlite:///./tahlil_umm_samah.db

# دومين موقعك (الفرونت إند) - يُستخدم لحماية CORS، بدون * مطلقاً بالإنتاج
ALLOWED_ORIGIN=http://localhost:3000
